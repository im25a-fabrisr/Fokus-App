<Application x:Class="Fokus.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
<Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#A7F3B0"/>
  <Style TargetType="TextBlock"><Setter Property="FontSize" Value="15"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="18,12"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="#A7F3B0"/><Setter Property="Foreground" Value="#12201B"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="16"/></Style>
</Application.Resources>
</Application>
