<Window x:Class="Fokus.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Fokus — Zeit für das Wesentliche" Width="960" Height="860" MinWidth="780" MinHeight="680" Background="#10151F" Foreground="#EBEEF5" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" Closing="OnClosing">
<ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="40">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="F O K U S" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="Platz für deine Gedanken." FontSize="32" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="Wähle deinen Modus. Nimm dir Zeit. Bleib bei einer Sache." Foreground="#A3AEC2"/></StackPanel>
<Border Grid.Row="1" Background="#1B2332" CornerRadius="18" Padding="24" Margin="0,26,0,20">
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock x:Name="SessionLabel" Text="Bereit, wenn du es bist" Foreground="{StaticResource Accent}"/><TextBlock x:Name="TimerLabel" Text="40:00" FontSize="64" FontWeight="SemiBold"/><TextBlock x:Name="StatusLabel" Text="Deine nächste konzentrierte Lernphase." Foreground="#A3AEC2" TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left"/></StackPanel>
<TextBlock Grid.Column="1" Text="◷" FontSize="80" Foreground="#344A45" VerticalAlignment="Center" Margin="20,0,0,0"/>
</Grid></Border>
<StackPanel Grid.Row="2" x:Name="SettingsPanel">
<TextBlock Text="DEINE FOKUSPHASE" FontSize="12" Foreground="#A3AEC2" FontWeight="Bold" Margin="0,0,0,12"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Fokusmodus" Margin="0,0,0,6"/><ComboBox x:Name="ModeBox" Foreground="#12201B" FontSize="16" Padding="10" SelectionChanged="ModeChanged"><ComboBoxItem Content="Lernen"/><ComboBoxItem Content="Schule"/><ComboBoxItem Content="Eigener Modus"/></ComboBox></StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="Dauer in Minuten" Margin="0,0,0,6"/><TextBox x:Name="MinutesBox" Text="40" TextChanged="DurationChanged"/></StackPanel>
</Grid>
<TextBlock Text="Programme während dieser Phase sperren" Margin="0,20,0,8"/>
<ListBox x:Name="BlockedList" Height="100" Background="#1B2332" Foreground="#EBEEF5" BorderThickness="0" Padding="8" DisplayMemberPath="DisplayName"/>
<StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Programm hinzufügen …" Click="AddProgram"/><Button Content="Entfernen" Click="RemoveProgram" Background="#29354A" Foreground="#EBEEF5"/></StackPanel>
<TextBlock Text="Die erste Version minimiert ausgewählte Programme, sobald du sie öffnest. Webseiten und Benachrichtigungen folgen später." TextWrapping="Wrap" Foreground="#A3AEC2" FontSize="12" Margin="0,12,0,0"/>
</StackPanel>
<StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,26,0,0"><Button x:Name="StartButton" Content="Fokus starten →" Click="StartFocus"/><Button x:Name="CancelButton" Content="Vorzeitig beenden" Click="CancelFocus" Visibility="Collapsed" Background="#29354A" Foreground="#EBEEF5"/><Button x:Name="KeepButton" Content="Weiter fokussieren" Click="KeepFocus" Visibility="Collapsed"/></StackPanel>
<TextBlock Grid.Row="4" x:Name="HintLabel" Text="Ein vorzeitiger Abbruch hat 30 Sekunden Bedenkzeit. Deine Sitzung bleibt beim erneuten Öffnen erhalten." Foreground="#A3AEC2" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,0"/>
</Grid></ScrollViewer>
</Window>
